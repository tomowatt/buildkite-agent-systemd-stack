# =============================================================================
# /etc/bk-stack/controller.env
#
# Environment configuration for bk-stack-controller.service.
# Permissions: chmod 640, chown root:bk-stack
# =============================================================================

# --- Required ----------------------------------------------------------------

# Buildkite cluster agent token (from Buildkite → Agents → Tokens)
BK_AGENT_TOKEN=

# A unique key identifying this stack instance on the cluster queue.
# Use something stable and descriptive, e.g. hostname or a fixed name.
BK_STACK_KEY=my-linux-stack

# Base URL for the Buildkite Agent API
BK_AGENTAPI_BASE_URL=https://agent.buildkite.com/v3

# --- Queue & concurrency -----------------------------------------------------

# The cluster queue this stack serves
BK_QUEUE=default

# Maximum number of concurrent agent units
BK_MAX_AGENTS=4

# Seconds between Stacks API polls
BK_POLL_INTERVAL=5

# Wall-clock timeout (seconds) for a single job unit before it is killed
BK_JOB_TIMEOUT=3600

# --- Shared paths ------------------------------------------------------------

# Directory for per-job agent workspaces (build checkouts)
BK_WORK_DIR=/var/lib/bk-stack/work

# Path to a file containing only the agent token value (mode 400, root:root).
# Used by the controller to pass the token to each job unit via LoadCredential,
# keeping it off the command line and out of `systemctl show` output.
# Written automatically by install.sh.
BK_AGENT_TOKEN_FILE=/etc/bk-stack/secrets/agent-token

# Shared bare-repo git mirrors (passed as --git-mirrors-path to agents)
BK_GIT_MIRRORS_PATH=/var/cache/bk-git-mirrors

# Shared dependency cache root (bind-mounted read-only into each agent unit)
BK_CACHE_PATH=/var/cache/bk-cache

# --- SSH credentials (choose one) -------------------------------------------

# Option A: Path to an SSH private key; injected via systemd LoadCredential.
# Strongest isolation — key material is only visible inside each unit.
BK_CREDENTIAL_SSH_KEY=/etc/bk-stack/secrets/id_ed25519

# Option B: Shared ssh-agent socket path (comment out Option A to use this).
# Simpler, but all concurrent jobs share the same agent.
# BK_SSH_AGENT_SOCK=/run/bk-ssh-agent.sock

# --- Extra agent environment -------------------------------------------------

# Path to an additional EnvironmentFile passed to every agent unit.
# Use for non-sensitive per-agent config (toolchain paths, registry mirrors, …)
# BK_EXTRA_ENV_FILE=/etc/bk-stack/agent-extra.env

# --- Logging -----------------------------------------------------------------

# Log verbosity: debug | info | warn | error
BK_LOG_LEVEL=info
